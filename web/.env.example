# Drishti Web Environment Configuration

# Set to "true" to run frontend-only demo mode with synthetic data (e.g. for Vercel deployment)
# Set to "false" or omit to connect to the live Drishti backend
VITE_DEMO_MODE=false

# Optional API URL override (defaults to current host / reverse proxy)
# VITE_API_URL=http://localhost:8000
