# Environment files and secrets (never commit or bake secrets)
.env
.env.*
!.env.example

# Version control and editor files
.git/
.gitignore
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker files
Dockerfile
.dockerignore
