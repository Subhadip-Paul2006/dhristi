#!/usr/bin/env python3
import sys
import json
import urllib.request

def fetch_live_location():
    # Attempt 1: ip-api.com
    try:
        req = urllib.request.Request("http://ip-api.com/json/", headers={"User-Agent": "curl/7.88.1"})
        with urllib.request.urlopen(req, timeout=2.5) as response:
            data = json.loads(response.read().decode("utf-8"))
            if data.get("status") == "success":
                city = data.get("city", "")
                region = data.get("regionName", "")
                country = data.get("country", "")
                lat = data.get("lat", "")
                lon = data.get("lon", "")
                parts = [p for p in [city, region, country] if p]
                loc_str = ", ".join(parts)
                if lat != "" and lon != "":
                    loc_str += f" ({lat}, {lon})"
                return loc_str
    except Exception:
        pass

    # Attempt 2: ipinfo.io fallback
    try:
        req = urllib.request.Request("https://ipinfo.io/json", headers={"User-Agent": "curl/7.88.1"})
        with urllib.request.urlopen(req, timeout=2.5) as response:
            data = json.loads(response.read().decode("utf-8"))
            city = data.get("city", "")
            region = data.get("region", "")
            country = data.get("country", "")
            loc = data.get("loc", "")
            parts = [p for p in [city, region, country] if p]
            loc_str = ", ".join(parts)
            if loc:
                loc_str += f" ({loc})"
            return loc_str
    except Exception:
        pass

    return None

def main():
    if len(sys.argv) < 2:
        return

    commit_msg_filepath = sys.argv[1]

    try:
        with open(commit_msg_filepath, "r", encoding="utf-8") as f:
            content = f.read()

        # Avoid duplicating if location is already present
        if "📍 Location:" in content or "📍 Live Location:" in content:
            return

        location = fetch_live_location()
        if not location:
            return

        location_tag = f"\n\n📍 Location: {location}"

        # If commit message has comments (lines starting with #), insert before comments
        lines = content.splitlines(keepends=True)
        first_comment_idx = None
        for i, line in enumerate(lines):
            if line.strip().startswith("#"):
                first_comment_idx = i
                break

        if first_comment_idx is not None:
            msg_part = "".join(lines[:first_comment_idx]).rstrip()
            comment_part = "".join(lines[first_comment_idx:])
            new_content = f"{msg_part}{location_tag}\n\n{comment_part}" if msg_part else f"{location_tag.strip()}\n\n{comment_part}"
        else:
            new_content = f"{content.rstrip()}{location_tag}\n"

        with open(commit_msg_filepath, "w", encoding="utf-8") as f:
            f.write(new_content)

    except Exception:
        pass

if __name__ == "__main__":
    main()
